<div class="auth-wrapper">
  <div class="auth-card">
    <div class="brand">
      <img class="auth-logo" src="/images/dog-logo-clip-art-dog-7f45f84a123ff7e53f3e2361838d02b5.png" alt="CACTF logo">
      <h1>Welcome back</h1>
      <p>Sign in to your CACTF account</p>
    </div>

    <form method="POST" action="/login">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter your username" required autofocus>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block" style="margin-top:.5rem">Sign In</button>
    </form>

    <p style="text-align:center;margin-top:1.5rem;font-size:.85rem;color:var(--text-secondary)">
      Don't have an account? <a href="/register">Create one</a>
    </p>
  </div>
</div>
