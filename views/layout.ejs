<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CACTF' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<% const isPublicPage = !user; %>

<% if (isPublicPage) { %>
  <!-- ═══ PUBLIC LAYOUT ═══ -->
  <nav class="public-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand"><img src="/images/dog-logo-clip-art-dog-7f45f84a123ff7e53f3e2361838d02b5.png" alt="CACTF logo"> <span>CACTF</span></a>
      <button class="nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="public-navigation">
        <a href="/#features">Features</a>
        <a href="/#pricing">Pricing</a>
        <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/register" class="btn btn-primary btn-sm">Get Started</a>
      </div>
    </div>
  </nav>

  <div class="public-content">
    <% if (typeof message !== 'undefined' && message) { %>
      <div style="max-width:600px;margin:1rem auto;padding:0 2rem;"><div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><div><%- message %></div></div></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="max-width:600px;margin:1rem auto;padding:0 2rem;"><div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i><div><%- error %></div></div></div>
    <% } %>
    <%- body %>
  </div>

<% } else { %>
  <!-- ═══ APP LAYOUT (Authenticated) ═══ -->
  <div class="app-shell">
    <aside class="app-sidebar">
      <div class="sidebar-brand">
        <img src="/images/dog-logo-clip-art-dog-7f45f84a123ff7e53f3e2361838d02b5.png" alt="CACTF logo" style="height: 36px; width: 36px; filter: drop-shadow(0 0 8px rgba(255,255,255,0.3)); border-radius: 8px;"> CACTF
      </div>
      
      <div class="sidebar-user">
        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80" alt="Avatar">
        <div>
          <div style="font-weight:700; font-size:1rem;"><%= user.username %></div>
          <div style="font-size:0.75rem; color:#10b981; display:flex; align-items:center; gap:0.3rem;">
            <div style="width:6px; height:6px; background:#10b981; border-radius:50%;"></div> Online
          </div>
        </div>
      </div>

      <div class="sidebar-menu">
        <div class="sidebar-section">
          <div class="sidebar-section-label">Main</div>
          <a href="/profile" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Dashboard') ? ' active' : '' %>">Overview</a>
          <% if (user && user.role === 'admin') { %>
          <a href="/search" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Customer') ? ' active' : '' %>">Users</a>
          <% } %>
          <a href="/transfer" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Billing') ? ' active' : '' %>">Earnings</a>
          <a href="/store" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Marketplace') ? ' active' : '' %>">Store</a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">Developer</div>
          <a href="/jwt/login" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('API') ? ' active' : '' %>">API Portal</a>
          <a href="/submit-flag" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Flag') ? ' active' : '' %>">Submit Flag</a>
        </div>
      </div>

      <a href="/logout" class="sidebar-footer">
        <i class="fa-solid fa-right-from-bracket"></i> Logout
      </a>
    </aside>

    <div class="app-main">
      <header class="app-topbar">
        <div class="topbar-search">
          <i class="fa-solid fa-magnifying-glass" style="color:var(--text-muted)"></i>
          <input type="text" placeholder="Search">
        </div>
        <div class="topbar-actions">
          <!-- Additional actions can go here -->
        </div>
      </header>

      <div class="app-content">
        <div class="app-content-inner">
          <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><div><%- message %></div></div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i><div><%- error %></div></div>
          <% } %>
          <%- body %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script src="/js/config.js"></script>
<script src="/js/app.js"></script>
<script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
