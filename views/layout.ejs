<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CACTF' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<% const isPublicPage = !user; %>

<% if (isPublicPage) { %>
  <!-- ═══ PUBLIC LAYOUT ═══ -->
  <nav class="public-nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand"><img src="/images/dog-logo-clip-art-dog-7f45f84a123ff7e53f3e2361838d02b5.png" alt="CACTF logo"> <span>CACTF</span></a>
      <button class="nav-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="public-navigation">
        <a href="/#features">Features</a>
        <a href="/#pricing">Pricing</a>
        <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/register" class="btn btn-primary btn-sm">Get Started</a>
      </div>
    </div>
  </nav>

  <div class="public-content">
    <% if (typeof message !== 'undefined' && message) { %>
      <div style="max-width:600px;margin:1rem auto;padding:0 2rem;"><div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><div><%- message %></div></div></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="max-width:600px;margin:1rem auto;padding:0 2rem;"><div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i><div><%- error %></div></div></div>
    <% } %>
    <%- body %>
  </div>

<% } else { %>
  <!-- ═══ APP LAYOUT (Authenticated) ═══ -->
  <div class="app-shell">
    <aside class="app-sidebar">
      <div class="sidebar-brand"><img src="/images/dog-logo-clip-art-dog-7f45f84a123ff7e53f3e2361838d02b5.png" alt="CACTF logo"> CACTF</div>
      <div class="sidebar-menu">
        <div class="sidebar-section">
          <div class="sidebar-section-label">Main</div>
          <a href="/profile" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Dashboard') ? ' active' : '' %>"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
          <a href="/search" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Customer') ? ' active' : '' %>"><i class="fa-solid fa-users"></i> Customers</a>
          <a href="/transfer" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Billing') ? ' active' : '' %>"><i class="fa-solid fa-file-invoice-dollar"></i> Billing</a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">Developer</div>
          <a href="/jwt/login" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('API') ? ' active' : '' %>"><i class="fa-solid fa-code"></i> API Portal</a>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-section-label">CTF</div>
          <a href="/submit-flag" class="sidebar-link<%= typeof title !== 'undefined' && title.includes('Flag') ? ' active' : '' %>"><i class="fa-solid fa-flag"></i> Submit Flag</a>
        </div>
      </div>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
          <div>
            <div style="font-weight:600;font-size:.8rem;color:rgba(255,255,255,.85)"><%= user.username %></div>
            <div style="font-size:.7rem;color:rgba(255,255,255,.4)"><%= user.email %></div>
          </div>
        </div>
      </div>
    </aside>

    <div class="app-main">
      <header class="app-topbar">
        <div class="topbar-title"><%= typeof title !== 'undefined' ? title : '' %></div>
        <div class="topbar-actions">
          <a href="/logout" class="btn btn-ghost btn-sm"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </div>
      </header>

      <div class="app-content">
        <div class="app-content-inner">
          <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i><div><%- message %></div></div>
          <% } %>
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-error"><i class="fa-solid fa-circle-xmark"></i><div><%- error %></div></div>
          <% } %>
          <%- body %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script src="/js/config.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
