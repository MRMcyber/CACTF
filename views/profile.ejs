<div class="page-header" style="margin-bottom: 1.5rem;">
  <h1 style="color: var(--text);">Overview</h1>
</div>

<% if (typeof sqli_flag !== 'undefined' && sqli_flag) { %>
  <div class="flag-banner" style="background: #ef4444; color: white; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.1rem; margin-bottom: 0.5rem;"><i class="fa-solid fa-flag"></i> Flag Captured</h2>
    <p style="font-size: 0.9rem; margin-bottom: 0.75rem;">Authentication bypass successful!</p>
    <div style="background: rgba(0,0,0,0.2); display: inline-block; padding: 0.5rem 1rem; border-radius: 6px; font-family: monospace; font-size: 1.1rem; font-weight: 700;"><%= sqli_flag %></div>
  </div>
<% } %>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
  <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
    <div style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Account Balance</div>
    <div style="display: flex; align-items: baseline; justify-content: space-between;">
      <div style="font-size: 1.8rem; font-weight: 700; color: var(--text);">$<%= (profile && profile.balance != null) ? (typeof profile.balance === 'number' ? profile.balance.toFixed(2) : parseFloat(profile.balance).toFixed(2)) : '0.00' %></div>
      <div style="color: #ef4444; font-size: 0.7rem; font-weight: 700; background: #fef2f2; padding: 2px 6px; border-radius: 4px;">10% &darr;</div>
    </div>
  </div>

  <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
    <div style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Account Status</div>
    <div style="display: flex; align-items: baseline; justify-content: space-between;">
      <div style="font-size: 1.5rem; font-weight: 700; color: var(--text);">Active</div>
      <div style="color: #10b981; font-size: 0.7rem; font-weight: 700; background: #ecfdf5; padding: 2px 6px; border-radius: 4px;">100% &uarr;</div>
    </div>
  </div>

  <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
    <div style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Member Since</div>
    <div style="display: flex; align-items: baseline; justify-content: space-between;">
      <div style="font-size: 1.2rem; font-weight: 700; color: var(--text); margin-top: 0.4rem;">
        <%= (profile && profile.created_at) ? new Date(profile.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'N/A' %>
      </div>
    </div>
  </div>

  <div class="card" style="padding: 1.25rem; margin-bottom: 0;">
    <div style="color: var(--text-secondary); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Total Orders</div>
    <div style="display: flex; align-items: baseline; justify-content: space-between;">
      <div style="font-size: 1.8rem; font-weight: 700; color: var(--text);">1000</div>
      <div style="color: #10b981; font-size: 0.7rem; font-weight: 700; background: #ecfdf5; padding: 2px 6px; border-radius: 4px;">10% &uarr;</div>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <!-- Bar Chart (Statistics) -->
  <div class="card" style="margin-bottom: 0; padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <h3 style="font-size: 1rem; font-weight: 700; color: var(--text); margin: 0;">Statistics</h3>
      <div style="display: flex; gap: 1rem; font-size: 0.75rem; color: var(--text-secondary); font-weight: 600;">
        <span style="display: flex; align-items: center; gap: 4px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary);"></div> Sales</span>
        <span style="display: flex; align-items: center; gap: 4px;"><div style="width: 8px; height: 8px; border-radius: 50%; background: #93c5fd;"></div> Returns</span>
      </div>
    </div>
    
    <div style="height: 200px; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); position: relative;">
      <!-- Y Axis -->
      <div style="position: absolute; left: 0; top: 0; bottom: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; color: var(--text-muted); font-size: 0.65rem;">
        <span>50k</span><span>40k</span><span>30k</span><span>20k</span><span>10k</span><span>0</span>
      </div>
      <!-- Bars -->
      <div style="width: 100%; display: flex; align-items: flex-end; justify-content: space-around; padding-left: 2rem;">
        <div style="width: 15px; height: 60%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 80%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 40%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 75%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 90%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 50%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
        <div style="width: 15px; height: 85%; background: var(--primary); border-radius: 4px 4px 0 0;"></div>
      </div>
    </div>
  </div>

  <!-- Donut Chart (Sales Breakdown) -->
  <div class="card" style="margin-bottom: 0; padding: 1.5rem; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h3 style="font-size: 1rem; font-weight: 700; color: var(--text); margin: 0;">Sales Breakdown</h3>
      <span style="font-size: 0.75rem; color: var(--text-secondary); background: var(--bg); padding: 2px 8px; border-radius: 12px;">Items &darr;</span>
    </div>
    <div style="flex: 1; display: flex; align-items: center; justify-content: center;">
      <!-- CSS Donut Chart -->
      <div style="width: 180px; height: 180px; border-radius: 50%; background: conic-gradient(var(--primary) 0% 45%, #60a5fa 45% 70%, #93c5fd 70% 90%, #dbeafe 90% 100%); display: flex; align-items: center; justify-content: center; position: relative;">
        <div style="width: 140px; height: 140px; background: white; border-radius: 50%;"></div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header" style="border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
    <h2 style="font-size: 1rem; font-weight: 700;"><i class="fa-solid fa-user"></i> Account Details</h2>
  </div>

  <div class="info-row">
    <div class="info-label">Username</div>
    <div class="info-value"><strong><%= profile ? profile.username : '' %></strong></div>
  </div>

  <div class="info-row">
    <div class="info-label">Email</div>
    <div class="info-value"><%= profile ? profile.email : '' %></div>
  </div>

  <div class="info-row">
    <div class="info-label">Full Name</div>
    <div class="info-value"><%= (profile && profile.full_name) ? profile.full_name : 'Not provided' %></div>
  </div>

  <div class="info-row">
    <div class="info-label">Phone</div>
    <div class="info-value"><%= (profile && profile.phone) ? profile.phone : 'Not provided' %></div>
  </div>

  <% if (profile && profile.bio) { %>
    <div class="info-row">
      <div class="info-label">Bio</div>
      <div class="info-value"><%= profile.bio %></div>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-header">
    <h2><i class="fa-solid fa-camera"></i> Profile Picture</h2>
  </div>
  
  <div style="display: flex; gap: 1.5rem; align-items: center; margin-bottom: 1rem;">
    <div>
      <img src="/profile/avatar?f=<%= typeof user !== 'undefined' && user.avatar ? user.avatar : 'default.png' %>" alt="Avatar" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border);">
    </div>
    <form action="/profile/upload" method="POST" enctype="multipart/form-data" style="flex: 1;">
      <div class="form-group" style="margin-bottom: 0.75rem;">
        <label for="avatar">Upload new avatar</label>
        <input type="file" id="avatar" name="avatar" accept="image/*" required style="padding: 0.5rem; border: 1px dashed var(--border); border-radius: 8px; width: 100%; display: block; margin-top: 0.25rem;">
      </div>
      <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-upload"></i> Upload</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2><i class="fa-solid fa-pen-to-square"></i> Update Bio</h2>
  </div>

  <form action="/profile/update" method="POST">
    <div class="form-group">
      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" rows="4" placeholder="Tell us about yourself..."><%= (profile && profile.bio) ? profile.bio : '' %></textarea>
    </div>
    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button>
  </form>
</div>

<script>
  // Fetch session data on load to populate UI elements
  fetch('/api/user/session-info')
    .then(r => r.json())
    .then(data => {
      console.log('Session info loaded.');
      // A lazy developer left the debug flag in the raw JSON response!
    });
</script>
