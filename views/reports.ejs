<div class="page-header">
  <h1>User Reports</h1>
  <p>Submitted user information and activity</p>
</div>

<div class="card">
  <div class="card-header">
    <h2><i class="fa-solid fa-file-lines"></i> Submitted User Information</h2>
    <a href="/admin/dashboard" class="btn btn-ghost btn-sm"><i class="fa-solid fa-arrow-left"></i> Back to Admin Panel</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Username</th>
        <th>Full Name</th>
        <th>Email</th>
        <th>Bio</th>
        <th>Joined</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
        <% users.forEach(function(user) { %>
          <tr>
            <td><%= user.id %></td>
            <td><strong><%= user.username %></strong></td>
            <td><%= user.full_name || 'N/A' %></td>
            <td><%= user.email || 'N/A' %></td>
            <td><%- user.bio || '' %></td>
            <td><%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'N/A' %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted);">No user activity reports found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
