<div class="page-header">
  <h1>User Reports</h1>
  <p>Submitted user information and activity</p>
</div>

<!-- Admin security token required for actions on this page -->
<meta name="csrf-token" content="<%= typeof reportToken !== 'undefined' ? reportToken : '' %>">

<script>
  // Admin-only diagnostics script (simulated)
