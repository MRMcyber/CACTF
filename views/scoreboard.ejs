<div class="page-header">
  <h1>Submit Flag</h1>
  <p>Capture flags by finding vulnerabilities and submit them here for points</p>
</div>

<!-- Submission Form -->
<div class="card">
  <div class="card-header"><h2>Enter a Flag</h2></div>
  <form method="POST" action="/submit-flag" style="display:flex;gap:.75rem;align-items:flex-end;">
    <div class="form-group" style="flex:1;margin-bottom:0;">
      <input type="text" name="flag" placeholder="flag{...}" required style="font-family:ui-monospace,monospace;">
    </div>
    <button type="submit" class="btn btn-primary" style="height:40px;">Submit</button>
  </form>
</div>

<!-- Progress -->
<div class="card">
  <div class="card-header">
    <h2>Your Progress</h2>
    <span style="font-size:.9rem;font-weight:600;color:var(--primary);"><%= totalScore %> / <%= maxScore %> pts</span>
  </div>

  <div style="background:var(--border-light);border-radius:9999px;height:8px;margin-bottom:1.5rem;overflow:hidden;">
    <div style="background:var(--primary);height:100%;border-radius:9999px;width:<%= maxScore > 0 ? Math.round((totalScore / maxScore) * 100) : 0 %>%;transition:width .3s;"></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Challenge</th>
        <th>Points</th>
        <th style="text-align:center">Status</th>
      </tr>
    </thead>
    <tbody>
      <% challenges.forEach(function(c) { %>
        <tr>
          <td style="font-weight:500"><%= c.name %></td>
          <td><%= c.points %> pts</td>
          <td style="text-align:center">
            <% if (c.found) { %>
              <span class="badge badge-success"><i class="fa-solid fa-check" style="margin-right:4px"></i> Captured</span>
            <% } else { %>
              <span class="badge" style="background:#f3f4f6;color:var(--text-muted)"><i class="fa-solid fa-lock" style="margin-right:4px"></i> Locked</span>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
